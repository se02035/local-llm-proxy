# LiteLLM Configuration
LITELLM_PORT=4000
# Master Key for Admin UI and authentication.
# NOTE: This is an admin key and will not show up in the LiteLLM UI 'Keys' list.
# If you want a key to appear in the UI, create a 'Virtual Key' in the LiteLLM Admin UI.
LITELLM_MASTER_KEY=[REDACTED]

# Ollama configuration
OLLAMA_HOST=[REDACTED]
OLLAMA_MODEL=[REDACTED]
# LiteLLM route (litellm-config.yaml). Compose sets this from OLLAMA_MODEL; set explicitly if not using Docker Compose.
LITELLM_OLLAMA_MODEL=[REDACTED]

# LiteLLM UI Credentials
UI_USERNAME=admin
UI_PASSWORD=[REDACTED]
# Database Credentials
POSTGRES_USER=[REDACTED]
POSTGRES_PASSWORD=[REDACTED]
POSTGRES_DB=litellm

# Ngrok configuration
NGROK_AUTHTOKEN=your_ngrok_token
