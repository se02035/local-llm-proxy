# LiteLLM Configuration
LITELLM_PORT=4000
# Master Key for Admin UI and authentication.
# NOTE: This is an admin key and will not show up in the LiteLLM UI 'Keys' list.
# If you want a key to appear in the UI, create a 'Virtual Key' in the LiteLLM Admin UI.
LITELLM_MASTER_KEY=sk-local-agent-secure-12345

# Ollama configuration
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# LiteLLM route (litellm-config.yaml). Compose sets this from OLLAMA_MODEL; set explicitly if not using Docker Compose.
LITELLM_OLLAMA_MODEL=ollama/qwen2.5-coder:14b

# LiteLLM UI Credentials
UI_USERNAME=admin
UI_PASSWORD=secure_admin_password_123
# Database Credentials
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=dbpassword9090
POSTGRES_DB=litellm

# Ngrok configuration
NGROK_AUTHTOKEN=your_ngrok_token
