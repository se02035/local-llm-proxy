# LiteLLM Configuration
# NOTE: This is an admin key and will not show up in the LiteLLM UI 'Keys' list.
# If you want a key to appear in the UI, create a 'Virtual Key' in the LiteLLM Admin UI.
LITELLM_MASTER_KEY=sk-local-litellm-admin-key
LITELLM_PORT=4000
# LiteLLM route (litellm-config.yaml). Keep this in sync with OLLAMA_MODEL.
LITELLM_OLLAMA_MODEL=ollama/gemma3:4b

# Ollama configuration (non-secret operational defaults; override for your environment).
OLLAMA_HOST=http://host.docker.internal:11434  # pragma: allowlist secret
OLLAMA_MODEL=gemma3:4b

# LiteLLM UI Credentials
UI_PASSWORD=change-me-admin-password
UI_USERNAME=admin

# Database Credentials
POSTGRES_PASSWORD=litellm_password
POSTGRES_USER=litellm
POSTGRES_DB=litellm

# Ngrok configuration
# Provide your own valid ngrok auth token.
NGROK_AUTHTOKEN=your_ngrok_token
